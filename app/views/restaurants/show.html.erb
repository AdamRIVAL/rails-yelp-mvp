<h3><%= @restaurant.name %></h3>
<h4><%= @restaurant.category %></h4>
<h4><%= @restaurant.address %></h4>
<h4><%= @restaurant.phone_number %></h4>

<ul>
  <% @restaurant.reviews.each do |review| %>
    <div>
      <p><%= review.rating %>/5  <%= review.content %></p>
    </div>
  <% end %>
</ul>

<h3>Donnez votre avis</h3>
<%= simple_form_for [@restaurant, @review] do |f| %>
  <%= f.input :rating %>
  <%= f.input :content %>
  <%= f.submit %>
<% end %>
<br>
<%= link_to "go back to the list", restaurants_path, class: "btn btn-primary" %>
